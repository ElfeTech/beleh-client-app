VITE_FIREBASE_API_KEY=your-api-key
# Use the same Firebase project as in the Firebase Console (Authentication + Hosting).
# Typical: your-project-id.firebaseapp.com — must align with OAuth redirect URIs in Google Cloud.
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
# Backend API (public help chat uses /api/public/help/* — often port 8002 locally)
VITE_API_BASE_URL=http://localhost:8002

# Analytics (Clarity + GA4/GTM) load only on production builds (npm run build), not in vite dev.

# Microsoft Clarity (session recordings & heatmaps). Defaults to project wvjpv4zk8t if unset.
# VITE_CLARITY_PROJECT_ID=wvjpv4zk8t

# Google Analytics 4 (gtag.js). Defaults to G-GP3JJHFPJ1 if unset.
# VITE_GA_MEASUREMENT_ID=G-GP3JJHFPJ1

# Google Tag Manager container ID (optional). When set, loads GTM alongside GA4.
# If GA4 is also configured inside GTM, remove direct gtag or disable one to avoid double counting.
# VITE_GTM_CONTAINER_ID=GTM-XXXXXXX
